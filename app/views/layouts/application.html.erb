<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Cocon" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body<% if current_account %> data-current-account-id="<%= current_account.id %>"<% end %>>
    <% if current_account %>
      <%= turbo_stream_from current_account %>
    <% end %>

    <header class="site-header">
      <div class="site-header__inner">
        <%= link_to "Cocon", root_path, class: "site-header__brand" %>
        <% if current_account %>
          <span class="site-header__user"><%= account_heading(current_account) %></span>
          <nav class="site-header__nav">
            <%= link_to "Annonces", listings_path %>
            <%= link_to conversations_path do %>
              Messagerie
              <%= render "conversations/unread_badge", account: current_account %>
            <% end %>
            <%= button_to "Déconnexion", logout_path, method: :delete, class: "btn btn-ghost" %>
          </nav>
        <% else %>
          <span class="site-header__hint">Connexion démo ci-dessous</span>
        <% end %>
      </div>
    </header>

    <main class="page">
      <% if notice.present? %>
        <p class="flash flash-notice"><%= notice %></p>
      <% end %>
      <% if alert.present? %>
        <p class="flash flash-alert"><%= alert %></p>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
