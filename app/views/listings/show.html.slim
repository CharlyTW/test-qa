.card
  h1 = listing.title
  p.meta
    | Auteur ·
    =< account_heading(listing.account)
  p.listing-show__body = listing.body

  - if current_account&.id == listing.account_id
    p.info-banner C'est votre annonce.
  - else
    .listing-show__actions
      = button_to "Contacter", contact_listing_path(listing), method: :post, class: "btn btn-primary"
